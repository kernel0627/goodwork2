# 复制成 .env 后只填写一种接入方式。.env 已被 git 忽略。
#   cp .env.example .env
#   python -m recon.cli llm-config     # 只检查解析结果，不联网、不显示完整密钥

# ==========================================================================
# 推荐：任意 OpenAI-compatible 接口
# ==========================================================================

# auto 会按以下优先级选择：
# 显式命令参数 > RECON_LLM_* > OPENAI_* > DEEPSEEK_* > OLLAMA_* > VLLM_*
RECON_LLM_PROVIDER=auto
RECON_LLM_MODEL=
RECON_LLM_BASE_URL=
RECON_LLM_API_KEY=

# endpoint 能力差异自适应：
# - json_mode=auto：优先 response_format，不支持就退回提示词约束 + 严格 JSON 解析
# - token_param=auto：优先 max_tokens，不支持就改用 max_completion_tokens
RECON_LLM_JSON_MODE=auto
RECON_LLM_TOKEN_PARAM=auto
RECON_LLM_TIMEOUT_SECONDS=90
RECON_LLM_MAX_RETRIES=3

# ==========================================================================
# 也可以使用供应商标准变量；无需复制到 RECON_LLM_*
# ==========================================================================

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=                  # 官方接口留空；兼容网关可填写 /v1 地址

# DeepSeek（兼容旧项目配置）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# RECON_AGENT_MODEL=deepseek-v4-flash

# Ollama：本地端点不需要真实 API key，地址会自动补 /v1
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://localhost:11434

# vLLM：本地地址不需要真实 API key；远程 vLLM 请改用上面的 RECON_LLM_*
# VLLM_MODEL=Qwen/Qwen3-8B
# VLLM_BASE_URL=http://localhost:8000/v1

# ==========================================================================
# 价格（元 / 百万 token）
# ==========================================================================

# 不填就明确显示「未配置价格」。这里不自动猜供应商单价。
RECON_PRICE_INPUT_PER_MTOK=
RECON_PRICE_CACHED_INPUT_PER_MTOK=
RECON_PRICE_OUTPUT_PER_MTOK=

# 旧名称仍兼容：
# RECON_PRICE_IN_MISS_PER_MTOK=
# RECON_PRICE_IN_HIT_PER_MTOK=
# RECON_PRICE_OUT_PER_MTOK=
